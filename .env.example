# Run python scripts/bootstrap.py to generate the real .env with random credentials.
TP_DEMO_MODE=true
TP_JWT_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
TP_ADMIN_PASSWORD=REPLACE_WITH_12_PLUS_CHARACTER_PASSWORD
TP_AGENCY_PASSWORD=REPLACE_WITH_12_PLUS_CHARACTER_PASSWORD
TP_DATABASE_URL=sqlite:///./tripparadox.db
TP_PG_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_STRONG_PASSWORD
TP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_STRONG_PASSWORD
TP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default: deliberately insecure test switches are inaccessible.
TP_ALLOW_INTENTIONAL_FLAWS=false
